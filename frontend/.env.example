# Copy this file to ".env" and fill in your Supabase project's values, then:
#   npm run build
#
# Both come from your Supabase project dashboard → Project Settings → API.
# VITE_SUPABASE_ANON_KEY is the publishable/anon key — safe to ship in a client bundle,
# it has no access beyond what the database's Row Level Security policies allow.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Exercise images/GIFs — a public Supabase Storage bucket, seeded once from
# github.com/hasaneyldrm/exercises-dataset (see docs/DATA_IMPORTS.md upstream).
# Point these at your own project once you've populated the "exercise-media" bucket.
VITE_IMG_BASE=https://your-project-ref.supabase.co/storage/v1/object/public/exercise-media/img/
VITE_GIF_BASE=https://your-project-ref.supabase.co/storage/v1/object/public/exercise-media/gif/
